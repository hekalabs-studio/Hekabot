# Salin file ini jadi ".env" lalu isi nilai-nilai di bawah dengan punyamu sendiri.
# JANGAN pernah commit file ".env" (isinya rahasia) -- yang boleh di-commit cuma
# ".env.example" ini (isinya cuma contoh/placeholder, bukan key beneran).

# API key Gemini gratis, bikin di https://aistudio.google.com/apikey
# Boleh isi 1 saja (GEMINI_API_KEY_1) atau lebih (GEMINI_API_KEY_2, _3, dst)
# supaya bot otomatis gantian key kalau salah satu kena limit gratis.
GEMINI_API_KEY_1=isi_api_key_gemini_kamu_di_sini
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Nomor WhatsApp owner (format internasional tanpa "+", contoh: 628123456789)
OWNER_NUMBER=

# LID owner (opsional, isi kalau fitur owner-only nolak nomor kamu sendiri --
# lihat komentar ownerLid di config.js buat cara ambilnya)
OWNER_LID=
